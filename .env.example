# Copia este archivo como .env.local (ignorado por git) y complétalo.
# En Vercel, carga las mismas variables en Settings → Environment Variables.

# --- Google ---
GOOGLE_SHEET_ID=14CKL3JQ34CDsxN-e-wQoRq2VOkooYUa3byPB1GQhv6c
# Proyecto de Google Cloud: catequesispanama
GOOGLE_SERVICE_ACCOUNT_EMAIL=lector-inscripciones@catequesispanama.iam.gserviceaccount.com
# Producción (Vercel): pega la private_key del JSON, con los saltos de línea como \n.
GOOGLE_PRIVATE_KEY=
# Solo local: ruta al JSON de la cuenta de servicio, FUERA del repositorio.
# Si GOOGLE_PRIVATE_KEY está vacía, la clave se lee de este archivo.
GOOGLE_SERVICE_ACCOUNT_FILE=
# ID de cliente OAuth de tipo "Aplicación web" (login del panel con Google Identity Services).
GOOGLE_CLIENT_ID=

# --- Escritor de Apps Script ---
APPS_SCRIPT_WRITER_URL=              # URL /exec del escritor
APPS_SCRIPT_WRITER_SECRET=           # >= 32 caracteres

# --- Secretos propios (>= 32 caracteres, distintos entre sí) ---
SESSION_SECRET=
QR_SECRET=

# --- Acceso ---
ADMIN_EMAILS=aovv.26@gmail.com
VERIFICADORES_EMAILS=

# --- Sitio ---
PUBLIC_SITE_URL=                     # local: http://localhost:4173 · producción: URL de Vercel
